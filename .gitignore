# ==============================================================================
# StudyMind AI — Production Git Ignore Policy
# ==============================================================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Local Databases & Persistent SQLite Files (Never commit user databases)
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Uploaded User Documents & Extracted Files (Never commit private user PDFs)
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/vector_store/*
!backend/data/vector_store/.gitkeep
backend/data/chat_history.json
backend/data/documents.json
backend/data/settings.json
backend/*.pdf

# Environment Files & API Secrets (Never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Node, NPM & Frontend Bundles
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE, OS & System Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.log
