# ==============================================================================
# StudyMind AI — Production Environment Variables
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# --- AI Intelligence Provider ---
# Optional: Get your Gemini API key from https://aistudio.google.com/app/apikey
# If omitted or left empty, StudyMind AI automatically uses its robust local-RAG synthesizer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Database & Persistence ---
# For SQLite (default, self-contained):
DATABASE_URL=sqlite:///./data/studymind.db
# For PostgreSQL (production cloud cluster):
# DATABASE_URL=postgresql://studymind_user:securepassword@localhost:5432/studymind_db

# --- Security & JWT Authentication ---
# Generate a strong 64-character random key in production: openssl rand -hex 32
JWT_SECRET=studymind_rag_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# --- Allowed CORS Origins (comma-separated list of frontends) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:80

# --- RAG Indexing & Retrieval Parameters ---
CHUNK_SIZE=750
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.15
EMBEDDING_MODEL=hybrid-semantic
